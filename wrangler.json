{
  "name": "droidtty",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/version.json"
    ]
  },
  "routes": [
    {
      "pattern": "droidtty.oiupoyt.space",
      "custom_domain": true
    }
  ],
  "main": "worker/index.js"
}
