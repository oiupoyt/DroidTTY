<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Swipe down opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" from an app's long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Tapping the clock opens the alarms screen. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Log rows: connection type, IP, Wi-Fi signal. Install-time, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- "aps" row: ask for a fresh Wi-Fi scan (Android still throttles them). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Real app names for system packages in the monitor (processes, connections, traffic). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Two uses, each switchable off: the update check (once a day, one small file from
         the fork's GitHub release; settings › about), and the optional DNS monitor, which
         relays apps' own lookups to the network's DNS server. Reverse DNS for the
         connections table runs in Shizuku's helper process, not under this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional lock-screen wallpaper (your image or a snapshot of the log). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- "radio" row: is Bluetooth on (Android 11 and older need this to ask). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Optional log rows; each is asked for only when the user switches that row on:
         GPS fix, satellites, Wi-Fi name, nearby networks, serving cell, sunrise (location);
         5G/LTE link details (phone); connected Bluetooth devices; steps. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- None of that hardware is required to install. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- System monitor: app switches, screen time, traffic. Granted by the user in
         Settings > Usage access; nothing happens without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Optional always-on display and lock cover: drawn over the lock screen after the
         screen turns off or on (granted by the user in Android's settings), with a
         foreground service that hears those events. Unlocking stays Android's own. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The update check, once a day, reads version.json from the fork's GitHub release;
         Android's installer then asks before replacing anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Wakes the screen for the always-on display. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- Shizuku, for the optional system monitor. -->
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SysReadoutApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SysReadout">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the Shizuku binder when the user has Shizuku running. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Optional DNS monitor; routes only DNS, see DnsVpnService. -->
        <service
            android:name=".monitor.DnsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Optional notification log: who notified when; see NotifListener. -->
        <service
            android:name=".monitor.NotifListener"
            android:exported="false"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Hands a downloaded update to Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Always-on display and lock cover, shown over the keyguard. -->
        <activity
            android:name=".cover.CoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.cover"
            android:theme="@style/Theme.SysReadout.Cover" />

        <!-- Invisible: opens Android's PIN pad straight from the boot screen. -->
        <activity
            android:name=".cover.UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.unlock"
            android:theme="@style/Theme.SysReadout.Unlock" />

        <service
            android:name=".cover.ScreenService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens for the screen turning off and on to show the user's always-on display and lock-screen cover." />
        </service>

        <!-- The always-on display as Android's screen saver. -->
        <service
            android:name=".cover.AodDream"
            android:exported="true"
            android:label="@string/aod_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Only used for double-tap-to-lock; reads no window content. -->
        <service
            android:name=".system.LockService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- No EmojiCompat (pulled in by Compose): on phones with Google Play services it
             has Play services download an emoji font (about 3 MB) from Google at first
             start. Emoji come from the system font instead. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
