<resources>
    <style name="Theme.SysReadout" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <!-- Black from the first frame, so the screen doesn't flash before the cover draws. -->
    <style name="Theme.SysReadout.Cover">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Nothing drawn: Android's own PIN pad shows through. -->
    <style name="Theme.SysReadout.Unlock" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <color name="bg">#FF050807</color>
    <color name="icon_fg">#FF3DFF8A</color>
    <color name="icon_dim">#FF1FB860</color>
    <color name="icon_glow">#3326FF7A</color>
    <color name="icon_scan">#22000000</color>
</resources>
